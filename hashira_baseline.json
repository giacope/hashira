{
  "version": 6,
  "packaging": "folder",
  "analyzers": [
    "complexity",
    "coupling",
    "duplication",
    "smells"
  ],
  "targets": [
    "lib/hashira"
  ],
  "edges": [
    "(root) -> analysis",
    "(root) -> complexity",
    "(root) -> coupling",
    "(root) -> duplication",
    "(root) -> hotspots",
    "(root) -> smells",
    "ci -> report",
    "cli -> (root)",
    "cli -> ci",
    "cli -> diagram",
    "cli -> report",
    "complexity -> analysis",
    "coupling -> analysis",
    "duplication -> analysis",
    "report -> duplication",
    "smells -> analysis"
  ],
  "findings": {},
  "boundaries": [
    {
      "root": "Prism",
      "role": "interpreted_model",
      "entrypoint": "lib/hashira/trees.rb",
      "reason": "every analyzer IS an AST pattern-matcher, so Prism reaches all of them by design: each smell asks about a different node type, so an adapter fronting them would mirror Prism's hierarchy and tax every new check without decoupling anything"
    }
  ]
}
