{
  "version": 6,
  "packaging": "folder",
  "analyzers": [
    "complexity",
    "coupling",
    "duplication",
    "smells"
  ],
  "targets": [
    "lib/hashira"
  ],
  "constraints": [
    "no_define_method@1.0.0:lib",
    "no_method_missing@1.0.0:lib"
  ],
  "edges": [
    "(root) -> complexity",
    "(root) -> constraints",
    "(root) -> coupling",
    "(root) -> duplication",
    "(root) -> hotspots",
    "(root) -> smells",
    "ci -> report",
    "cli -> (root)",
    "cli -> ci",
    "cli -> constraints",
    "cli -> diagram",
    "cli -> report",
    "complexity -> analysis",
    "constraints -> analysis",
    "coupling -> analysis",
    "duplication -> analysis",
    "report -> duplication",
    "smells -> analysis",
    "smells -> constraints"
  ],
  "findings": {},
  "accepted": [
    {
      "kind": "boundary_sprawl",
      "package": "Prism",
      "reason": "every analyzer IS an AST pattern-matcher, so Prism reaches all of them by design: each smell asks about a different node type, so an adapter fronting them would mirror Prism's hierarchy and tax every new check without decoupling anything"
    }
  ]
}
