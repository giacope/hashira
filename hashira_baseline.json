{
  "version": 7,
  "packaging": "folder",
  "analyzers": [
    "complexity",
    "coupling",
    "duplication",
    "smells"
  ],
  "targets": [
    "lib/hashira"
  ],
  "kinds": [
    "assumed_state",
    "boundary_sprawl",
    "complexity",
    "control_parameter",
    "cycle",
    "data_clump",
    "duplication",
    "feature_envy",
    "indirection",
    "manual_dispatch",
    "mixed_audience",
    "module_initialize",
    "nil_check",
    "repeated_call",
    "repeated_conditional",
    "roll_call",
    "sdp_violation",
    "state_sprawl",
    "utility_function",
    "wide_edge"
  ],
  "edges": [
    "(root) -> analysis",
    "(root) -> complexity",
    "(root) -> config",
    "(root) -> coupling",
    "(root) -> duplication",
    "(root) -> hotspots",
    "(root) -> smells",
    "(root) -> suppression",
    "ci -> report",
    "cli -> (root)",
    "cli -> ci",
    "cli -> config",
    "cli -> diagram",
    "cli -> report",
    "complexity -> analysis",
    "coupling -> analysis",
    "duplication -> analysis",
    "report -> duplication",
    "smells -> analysis",
    "suppression -> analysis",
    "suppression -> config"
  ],
  "findings": {},
  "boundaries": [
    {
      "root": "Prism",
      "role": "interpreted_model",
      "entrypoint": "lib/hashira/trees.rb",
      "reason": "every analyzer IS an AST pattern-matcher, so Prism reaches all of them by design: each smell asks about a different node type, so an adapter fronting them would mirror Prism's hierarchy and tax every new check without decoupling anything"
    }
  ]
}
