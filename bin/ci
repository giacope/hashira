#!/usr/bin/env bash
# Every check CI runs, runnable locally. Any failure fails the build.
set -euo pipefail
cd "$(dirname "$0")/.."

bundle exec rubocop
bundle exec rubocop-kata doctor # config entries and disable comments that no longer do anything
bundle exec rspec # spec_helper enforces the coverage floor (99% line and branch)
bundle exec exe/hashira --fail-on all # every kind .hashira.yml checks; no baseline to keep

echo "bin/ci: all checks passed ✓"
